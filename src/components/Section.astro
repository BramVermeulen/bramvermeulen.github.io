---
interface Props {
  title: string;
  id?: string;
}

const { title, id } = Astro.props;
---

<section
  id={id}
  class="grid scroll-mt-24 gap-x-8 gap-y-4 sm:grid-cols-[8rem_1fr]"
>
  <div class="flex flex-col gap-2 pt-1.5">
    <h2 class="rubric">{title}</h2>
    <div class="rubric-rule hidden sm:block"></div>
  </div>
  <div class="flex min-w-0 flex-col gap-4">
    <slot />
  </div>
</section>
