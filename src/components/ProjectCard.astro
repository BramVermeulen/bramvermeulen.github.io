---
import Chip from './Chip.astro';
import { type TechName } from '../data/tech';

interface Props {
  name: string;
  description: string;
  link?: string | null;
  tags: TechName[];
}

const { name, description, link, tags } = Astro.props;
---

<li
  class="plaque group hover:border-primary/45 hover:shadow-primary/10 relative p-5 transition duration-300 hover:-translate-y-1 hover:shadow-lg motion-reduce:transition-none motion-reduce:hover:translate-y-0"
>
  <h3 class="mb-2 text-base font-semibold tracking-wide">
    {
      link ? (
        <a
          href={link}
          class="group-hover:text-primary transition-colors after:absolute after:inset-0"
        >
          {name}
          <span
            aria-hidden="true"
            class="text-primary/70 inline-block transition-transform duration-300 group-hover:translate-x-1"
          >
            &rarr;
          </span>
        </a>
      ) : (
        name
      )
    }
  </h3>
  <p class="text-muted-foreground text-prose mb-4 leading-relaxed">
    {description}
  </p>
  <ul class="flex flex-wrap gap-1.5">
    {
      /* Deliberately not links: the whole card is one click target via the
         title link's overlay, and clickable tags here would make a card click
         land on a vendor site by accident. */
      tags.map((tag) => (
        <Chip as="li" variant="tag">
          {tag}
        </Chip>
      ))
    }
  </ul>
</li>
