---
import Chip from './Chip.astro';
import { techLinks, type TechName } from '../data/tech';

interface Props {
  name: string;
  description: string;
  link?: string | null;
  tags: TechName[];
}

const { name, description, link, tags } = Astro.props;
---

<li
  class="plaque group hover:border-primary/45 hover:shadow-primary/10 relative p-5 transition duration-300 hover:-translate-y-1 hover:shadow-lg motion-reduce:transition-none motion-reduce:hover:translate-y-0"
>
  <h3 class="mb-2 text-base font-semibold tracking-wide">
    {
      link ? (
        <a
          href={link}
          class="group-hover:text-primary transition-colors after:absolute after:inset-0"
        >
          {name}
          <span
            aria-hidden="true"
            class="text-primary/70 inline-block transition-transform duration-300 group-hover:translate-x-1"
          >
            &rarr;
          </span>
        </a>
      ) : (
        name
      )
    }
  </h3>
  <p class="text-muted-foreground text-prose mb-4 leading-relaxed">
    {description}
  </p>
  <ul class="flex flex-wrap gap-1.5">
    {
      /* The title link stretches an `after:absolute after:inset-0` overlay
         across the whole card. These tag links are siblings of that link (never
         nested inside it, which would be invalid HTML), and `relative z-10`
         lifts them above the overlay so they stay clickable in their own
         right. */
      tags.map((tag) => (
        <li>
          <Chip
            as="a"
            variant="tag"
            href={techLinks[tag]}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:border-primary/50 hover:text-foreground relative z-10 block transition-colors"
          >
            {tag}
          </Chip>
        </li>
      ))
    }
  </ul>
</li>
