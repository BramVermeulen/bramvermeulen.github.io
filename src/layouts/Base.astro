---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-image.png', Astro.site);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Bram Vermeulen',
  jobTitle: 'Full-Stack Engineer',
  url: Astro.site,
  sameAs: [
    'https://github.com/BramVermeulen',
    'https://www.linkedin.com/in/vermeulen-bram/',
  ],
  worksFor: {
    '@type': 'Organization',
    name: 'Steen Elektriciteit',
    url: 'https://www.steen-elektriciteit.be/',
  },
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Bram Vermeulen" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    />
    <script is:inline>
      const media = window.matchMedia('(prefers-color-scheme: dark)');
      // Storage can throw (private mode, in-app browsers, extensions);
      // fall back to session-only theming instead of dying.
      const storedTheme = () => {
        try {
          return localStorage.getItem('theme');
        } catch {
          return null;
        }
      };
      const applyTheme = (mode) => {
        document.documentElement.dataset.themeMode = mode;
        document.documentElement.classList.toggle(
          'dark',
          mode === 'dark' || (mode === 'system' && media.matches),
        );
      };
      applyTheme(storedTheme() ?? 'system');
      media.addEventListener('change', () => {
        if (!storedTheme()) applyTheme('system');
      });
    </script>
  </head>
  <body class="bg-background text-foreground min-h-dvh font-sans antialiased">
    <header
      class="border-border/60 bg-background/80 sticky top-0 z-10 border-b backdrop-blur"
    >
      <nav
        class="mx-auto flex max-w-3xl items-center justify-between px-5 py-3"
      >
        <a href="/" class="font-semibold tracking-tight">Bram Vermeulen</a>
        <div class="text-muted-foreground flex items-center gap-5 text-sm">
          <a
            class="nav-link hover:text-foreground hidden sm:block"
            href="/#projects">Projects</a
          >
          <a
            class="nav-link hover:text-foreground hidden sm:block"
            href="/#skills">Skills</a
          >
          <a
            class="nav-link hover:text-foreground hidden sm:block"
            href="/#contact">Contact</a
          >
          <button
            id="theme-toggle"
            aria-label="Switch theme (light / dark / system)"
            title="Theme: system"
            class="hover:bg-muted hover:text-foreground cursor-pointer rounded-md p-1.5 transition-colors"
          >
            <svg
              class="theme-icon icon-light size-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            >
              <circle cx="12" cy="12" r="4"></circle>
              <path
                d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4"
              ></path>
            </svg>
            <svg
              class="theme-icon icon-dark size-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            >
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
            </svg>
            <svg
              class="theme-icon icon-system size-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="2" y="3" width="20" height="14" rx="2"></rect>
              <path d="M8 21h8m-4-4v4"></path>
            </svg>
          </button>
        </div>
      </nav>
    </header>

    <slot />

    <footer class="border-border/60 border-t">
      <div
        class="text-muted-foreground mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-2 px-5 py-8 text-sm"
      >
        <p>&copy; {new Date().getFullYear()} Bram Vermeulen</p>
        <p>Built with Astro &amp; Tailwind CSS</p>
      </div>
    </footer>

    <script is:inline>
      const toggle = document.getElementById('theme-toggle');
      toggle.title = `Theme: ${document.documentElement.dataset.themeMode}`;
      toggle.addEventListener('click', () => {
        const order = ['light', 'dark', 'system'];
        const current = document.documentElement.dataset.themeMode ?? 'system';
        const next = order[(order.indexOf(current) + 1) % order.length];
        document.documentElement.dataset.themeMode = next;
        document.documentElement.classList.toggle(
          'dark',
          next === 'dark' ||
            (next === 'system' &&
              window.matchMedia('(prefers-color-scheme: dark)').matches),
        );
        toggle.title = `Theme: ${next}`;
        try {
          if (next === 'system') localStorage.removeItem('theme');
          else localStorage.setItem('theme', next);
        } catch {
          // Storage blocked: theme still applies, it just won't persist.
        }
      });
    </script>
  </body>
</html>
