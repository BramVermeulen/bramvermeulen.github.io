---
import '../styles/global.css';
import Ornament from '../components/Ornament.astro';
import { skillNames } from '../data/skills';

interface Props {
  title: string;
  description: string;
  /**
   * Name of this page in the trail below the homepage. Given one, the page
   * gets a BreadcrumbList; the URL comes from the canonical, so only the
   * label ever needs saying.
   */
  breadcrumb?: string;
  /**
   * Marks this page as the profile the Person node belongs to. Only the
   * homepage is that page, so only it sets this.
   */
  profilePage?: boolean;
  /** Set false on pages that aren't real content, such as the 404. */
  schema?: boolean;
}

const {
  title,
  description,
  breadcrumb,
  profilePage = false,
  schema = true,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// 1200x630, the landscape ratio LinkedIn and the other unfurlers want; the
// dimensions let them reserve the slot before the file has loaded.
const ogImage = new URL('/og-image-wide.png', Astro.site);

const personId = new URL('#person', Astro.site).href;
const websiteId = new URL('#website', Astro.site).href;

// Static site: this is evaluated once, when the site is built, so it is the
// same honest "last changed" stamp the sitemap's <lastmod> carries.
const built = new Date().toISOString();

const person = {
  '@type': 'Person',
  '@id': personId,
  name: 'Bram Vermeulen',
  jobTitle: 'Full-Stack Engineer',
  description:
    "Belgian full-stack developer with a Bachelor's degree in Applied " +
    'Computer Science, working on ERP systems, declarative infrastructure ' +
    'and monitoring pipelines.',
  url: Astro.site,
  // The homepage wordmark is inline svg now, so the share card is the one
  // raster of the brand left to hand the consumers that want a bitmap.
  image: ogImage.href,
  sameAs: [
    'https://github.com/BramVermeulen',
    'https://www.linkedin.com/in/vermeulen-bram/',
  ],
  nationality: {
    '@type': 'Country',
    name: 'Belgium',
  },
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'BE',
  },
  knowsAbout: skillNames,
  worksFor: {
    '@type': 'Organization',
    name: 'Steen Elektriciteit',
    url: 'https://www.steen-elektriciteit.be/',
  },
};

const website = {
  '@type': 'WebSite',
  '@id': websiteId,
  url: Astro.site,
  name: 'Bram Vermeulen',
  publisher: { '@id': personId },
  dateModified: built,
};

// Google's ProfilePage shape: the page that *is* somebody's profile, pointing
// at the Person it describes. Only the homepage qualifies.
const profile = profilePage && {
  '@type': 'ProfilePage',
  '@id': canonical.href,
  url: canonical.href,
  mainEntity: { '@id': personId },
  dateModified: built,
};

const breadcrumbList = breadcrumb && {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.href },
    {
      '@type': 'ListItem',
      position: 2,
      name: breadcrumb,
      item: canonical.href,
    },
  ],
};

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    person,
    website,
    ...(profile ? [profile] : []),
    ...(breadcrumbList ? [breadcrumbList] : []),
  ],
};
---

<html lang="en" class="dark" data-theme-mode="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#15110f" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/eb-garamond-latin-400-normal.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/cinzel-latin-700-normal.woff2"
      crossorigin
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Bram Vermeulen" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Bram Vermeulen - Full-Stack Engineer"
    />
    <meta name="twitter:card" content="summary_large_image" />
    {
      schema && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(graph)}
        />
      )
    }
    <script is:inline>
      const media = window.matchMedia('(prefers-color-scheme: dark)');
      // Storage can throw (private mode, in-app browsers, extensions);
      // fall back to session-only theming instead of dying.
      const storedTheme = () => {
        try {
          return localStorage.getItem('theme');
        } catch {
          return null;
        }
      };
      // hsl(--background) from global.css, as hex; the static <meta> above
      // carries the dark one, since dark is server-rendered. Reading the
      // computed value here is unreliable pre-paint, so keep these in sync
      // with the tokens by hand.
      const themeColor = { light: '#ebe4d6', dark: '#15110f' };
      const themeColorMeta = document.querySelector('meta[name="theme-color"]');
      // Shared with the toggle script at the end of <body>.
      window.applyTheme = (mode) => {
        const dark = mode === 'dark' || (mode === 'system' && media.matches);
        document.documentElement.dataset.themeMode = mode;
        document.documentElement.classList.toggle('dark', dark);
        themeColorMeta.content = dark ? themeColor.dark : themeColor.light;
      };
      // Dark is the default; the toggle can still override it.
      window.applyTheme(storedTheme() ?? 'dark');
      media.addEventListener('change', () => {
        if (storedTheme() === 'system') window.applyTheme('system');
      });
    </script>
  </head>
  <body class="bg-background text-foreground font-body min-h-dvh antialiased">
    <header
      class="border-border/70 bg-background/85 sticky top-0 z-40 border-b backdrop-blur-sm"
    >
      <nav
        class="mx-auto flex max-w-3xl items-center justify-between px-5 py-3"
      >
        <a
          href="/"
          class="group hover:text-primary flex items-center gap-2.5 transition-colors"
        >
          <svg
            class="text-primary size-5 shrink-0"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M12 2 20 4.5 V11 C20 15.5 17 19 12 21.5 C7 19 4 15.5 4 11 V4.5 Z"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linejoin="round"></path>
            {
              /* Four windmill sails, each offset to one side of its stock
                 as on a traditional Dutch mill */
              [45, 135, 225, 315].map((angle) => (
                <g transform={`rotate(${angle} 12 11)`}>
                  <path d="M11.65 11 V9.3 H9.5 V4.9 H12.35 V11 Z" />
                </g>
              ))
            }
            <circle cx="12" cy="11" r="1.1"></circle>
          </svg>
          <span class="font-display tracking-caps text-sm font-bold uppercase"
            >Bram Vermeulen</span
          >
        </a>
        <div class="text-muted-foreground flex items-center gap-6">
          <a
            class="nav-link hover:text-foreground hidden sm:block"
            href="/#projects">Projects</a
          >
          <a
            class="nav-link hover:text-foreground hidden sm:block"
            href="/#skills">Skills</a
          >
          <a
            class="nav-link hover:text-foreground hidden sm:block"
            href="/#contact">Contact</a
          >
          <button
            id="theme-toggle"
            aria-label="Switch theme (light / dark / system)"
            title="Theme: dark"
            class="border-border/70 hover:border-primary/50 hover:text-primary cursor-pointer border p-1.5 transition-colors"
          >
            <svg
              class="theme-icon icon-light size-4"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              display="none"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
            >
              <circle cx="12" cy="12" r="4"></circle>
              <path
                d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4"
              ></path>
            </svg>
            <svg
              class="theme-icon icon-dark size-4"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
            >
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
            </svg>
            <svg
              class="theme-icon icon-system size-4"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              display="none"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="2" y="3" width="20" height="14" rx="1"></rect>
              <path d="M8 21h8m-4-4v4"></path>
            </svg>
          </button>
        </div>
      </nav>
    </header>

    <slot />

    <footer class="border-border/70 border-t">
      <div class="mx-auto max-w-3xl px-5 py-8">
        <Ornament class="mb-6" />
        <p
          class="text-muted-foreground font-display tracking-caps text-center text-xs uppercase"
        >
          &copy; {new Date().getFullYear()} Bram Vermeulen
        </p>
      </div>
    </footer>

    <script is:inline>
      const toggle = document.getElementById('theme-toggle');
      toggle.title = `Theme: ${document.documentElement.dataset.themeMode}`;
      toggle.addEventListener('click', () => {
        const order = ['dark', 'light', 'system'];
        const current = document.documentElement.dataset.themeMode ?? 'dark';
        const next = order[(order.indexOf(current) + 1) % order.length];
        window.applyTheme(next);
        toggle.title = `Theme: ${next}`;
        try {
          localStorage.setItem('theme', next);
        } catch {
          // Storage blocked: theme still applies, it just won't persist.
        }
      });
    </script>
  </body>
</html>
