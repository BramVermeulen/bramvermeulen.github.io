---
import { Image } from 'astro:assets';

import avatar from '../assets/avatar.png';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import ProjectCard from '../components/ProjectCard.astro';

const projects = [
  {
    name: 'This website',
    description:
      'The site you are looking at: a static Astro site styled with Tailwind ' +
      'CSS, built in a Nix dev shell and deployed to GitHub Pages on every ' +
      'push. Click through for the full breakdown.',
    link: '/projects/portfolio',
    tags: ['Astro', 'Tailwind CSS', 'GitHub Actions', 'Nix'],
  },
];

const skills = [
  {
    group: 'Running in production',
    items: [
      'Python',
      'Odoo',
      'PostgreSQL',
      'TypeScript',
      'Linux',
      'Docker',
      'NixOS',
    ],
  },
  {
    group: 'Battle-tested',
    items: [
      'Go',
      'C#',
      '.NET',
      'Angular',
      'Node.js',
      'Kubernetes',
      'SQL Server',
      'MySQL',
      'MongoDB',
      'Prometheus',
      'Grafana',
    ],
  },
];
---

<Base
  title="Bram Vermeulen — Full-Stack Engineer"
  description="Bram Vermeulen — full-stack engineer from Belgium working on ERP systems, declarative infrastructure and monitoring pipelines."
>
  <main class="relative mx-auto max-w-3xl px-5">
    <div
      class="hero-glow pointer-events-none absolute inset-x-0 top-0 h-96"
      aria-hidden="true"
    >
    </div>

    <section
      class="animate relative flex flex-col items-center gap-5 py-20 text-center"
    >
      <a
        href="https://github.com/BramVermeulen"
        aria-label="Bram Vermeulen on GitHub"
        class="border-border from-primary/20 to-primary/5 hover:border-primary/40 hover:shadow-primary/10 rounded-full border bg-gradient-to-br p-1 transition duration-300 hover:scale-105 hover:shadow-lg motion-reduce:transition-none motion-reduce:hover:scale-100"
      >
        <Image
          src={avatar}
          alt="Bram Vermeulen"
          width={192}
          height={192}
          loading="eager"
          fetchpriority="high"
          class="size-24 rounded-full"
        />
      </a>
      <div>
        <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">
          Bram Vermeulen
        </h1>
        <p class="text-muted-foreground mt-3 text-lg">Full-Stack Engineer</p>
      </div>

      <div
        class="text-muted-foreground flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm"
      >
        <a
          href="https://www.google.com/maps/place/Belgium/"
          class="hover:text-foreground flex items-center gap-1.5 transition-colors"
        >
          <svg
            class="size-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          Belgium
        </a>
        <a
          href="https://github.com/BramVermeulen"
          class="hover:text-foreground flex items-center gap-1.5 transition-colors"
        >
          <svg
            class="size-4"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-1.94c-3.2.7-3.87-1.54-3.87-1.54-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.69 1.25 3.34.96.1-.75.4-1.25.73-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.59.23 2.76.11 3.05.74.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.25 5.67.41.35.78 1.05.78 2.12v3.15c0 .3.21.66.8.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"
            ></path>
          </svg>
          GitHub
        </a>
        <a
          href="https://www.linkedin.com/in/vermeulen-bram/"
          class="hover:text-foreground flex items-center gap-1.5 transition-colors"
        >
          <svg
            class="size-4"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05a3.74 3.74 0 0 1 3.37-1.85c3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.55V9h3.57v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"
            ></path>
          </svg>
          LinkedIn
        </a>
      </div>

      <p
        class="border-border bg-card flex items-center gap-x-3 rounded-full border px-4 py-2 text-sm shadow-sm transition-shadow hover:shadow-md"
      >
        <span class="relative flex size-2 items-center justify-center">
          <span
            class="absolute size-2 animate-ping rounded-full bg-green-400 opacity-75 motion-reduce:hidden"
          ></span>
          <span class="size-2 rounded-full bg-green-400"></span>
        </span>
        <span class="text-muted-foreground font-medium">
          Currently building ERP &amp; infrastructure tooling
        </span>
      </p>
    </section>

    <div class="relative flex flex-col gap-16 pb-24">
      <div class="animate" style="animation-delay: 150ms">
        <Section title="About">
          <div class="text-muted-foreground flex flex-col gap-3">
            <p>
              I'm a Belgian full-stack developer with a Bachelor's degree in
              Applied Computer Science. I have experience across a wide range of
              technologies, from running Go services on Kubernetes and .NET on
              Azure, to frontend work with Angular. These days, I primarily work
              with Python and Odoo.
            </p>
            <p>
              Right now, I'm at <a
                href="https://www.steen-elektriciteit.be/"
                class="link">Steen Elektriciteit</a
              >, an electrical contractor, where I connect business processes
              with software by scaling our ERP system and integrating it with
              peripheral tools.
            </p>
            <p>
              In my free time, I'm into infrastructure you can rebuild entirely
              from a text file. This includes declarative NixOS machines, solid
              monitoring with time-series storage, and writing automation that
              removes friction rather than creating it.
            </p>
          </div>
        </Section>
      </div>

      <div class="animate" style="animation-delay: 250ms">
        <Section title="Projects" id="projects">
          <ul class="grid gap-4">
            {
              projects.map((project) => (
                <ProjectCard
                  name={project.name}
                  description={project.description}
                  link={project.link}
                  tags={project.tags}
                />
              ))
            }
          </ul>
        </Section>
      </div>

      <div class="animate" style="animation-delay: 350ms">
        <Section title="Skills" id="skills">
          <dl class="flex flex-col gap-3">
            {
              skills.map(({ group, items }) => (
                <div class="flex flex-col gap-1.5 sm:flex-row sm:items-baseline sm:gap-4">
                  <dt class="w-44 shrink-0 text-sm font-medium">{group}</dt>
                  <dd class="m-0 flex flex-wrap gap-1.5">
                    {items.map((item) => (
                      <span class="border-border bg-muted text-muted-foreground hover:border-primary/40 hover:text-foreground rounded-full border px-2.5 py-0.5 text-xs transition-colors">
                        {item}
                      </span>
                    ))}
                  </dd>
                </div>
              ))
            }
          </dl>
        </Section>
      </div>

      <div class="animate" style="animation-delay: 450ms">
        <Section title="Contact" id="contact">
          <p class="text-muted-foreground">
            The best place to reach me is on <a
              href="https://www.linkedin.com/in/vermeulen-bram/"
              class="link">LinkedIn</a
            >.
          </p>
        </Section>
      </div>
    </div>
  </main>
</Base>
