---
import Base from '../../layouts/Base.astro';
import Ornament from '../../components/Ornament.astro';
import Chip from '../../components/Chip.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import TechLink from '../../components/TechLink.astro';
import { techLinks, type TechName } from '../../data/tech';

const stack: TechName[] = ['Astro', 'Tailwind CSS', 'GitHub Actions', 'Nix'];

// Said once, so a rename flows through the title, the heading and the
// breadcrumb together.
const name = 'This website';
---

<Base
  title={`${name} - Bram Vermeulen`}
  description="How this portfolio site is built: Astro, Tailwind CSS, a Nix dev shell and automated deploys to GitHub Pages."
  breadcrumb={name}
>
  <main class="relative mx-auto max-w-3xl px-5 pb-24">
    <div
      class="hero-glow pointer-events-none absolute inset-x-0 top-0 h-72"
      aria-hidden="true"
    >
    </div>

    <article class="relative flex flex-col gap-10 pt-14">
      <header class="animate flex flex-col items-start gap-4">
        <a
          href="/#projects"
          class="text-muted-foreground hover:text-primary font-display tracking-caps-wide text-fine uppercase transition-colors"
        >
          &larr; Back to projects
        </a>
        <h1 class="tracking-title text-2xl font-bold uppercase sm:text-3xl">
          {name}
        </h1>
        <Ornament class="w-full max-w-sm self-start" />
      </header>

      <section
        class="animate flex flex-col gap-3"
        style="animation-delay: 100ms"
      >
        <SectionHeading numeral="I" title="Project Overview" />
        <p class="text-muted-foreground">
          <span class="dropcap">T</span>his is a static portfolio site, built
          with the same approach I use for all my projects: reproducible builds,
          declarative tooling, and automated deployments.
        </p>
      </section>

      <section
        class="animate flex flex-col gap-4"
        style="animation-delay: 180ms"
      >
        <SectionHeading numeral="II" title="The Stack" />
        <ul class="flex flex-wrap gap-1.5">
          {
            stack.map((name) => (
              <li>
                <Chip
                  as="a"
                  href={techLinks[name]}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block"
                >
                  {name}
                </Chip>
              </li>
            ))
          }
        </ul>
        <p class="text-muted-foreground">
          I built the site using <TechLink name="Astro" />, a static-site
          framework that ships zero JavaScript by default. In fact, the
          dark-mode toggle is the only script running on this page. For styling,
          I used <TechLink name="Tailwind CSS" /> with the color system defined as
          HSL design tokens, allowing both light and dark themes to share a single
          palette definition.
        </p>
      </section>

      <section
        class="animate flex flex-col gap-3"
        style="animation-delay: 260ms"
      >
        <SectionHeading numeral="III" title="Reproducible Development" />
        <p class="text-muted-foreground">
          I don't keep a global <TechLink name="Node.js" /> installation on my machines.
          Instead, a <TechLink name="Nix" /> flake in the repository handles the toolchain.
          Running <code
            class="bg-muted border-border/70 text-code border px-1.5 py-0.5 font-mono"
            >nix develop</code
          > gives any machine the exact same environment instantly. This follows the
          same philosophy as the rest of my infrastructure: if it isn't defined in
          a text file, it doesn't exist.
        </p>
      </section>

      <section
        class="animate flex flex-col gap-3"
        style="animation-delay: 340ms"
      >
        <SectionHeading numeral="IV" title="Deployment" />
        <p class="text-muted-foreground">
          Every push to the <code
            class="bg-muted border-border/70 text-code border px-1.5 py-0.5 font-mono"
            >main</code
          > branch triggers a <TechLink name="GitHub Actions" /> workflow that builds
          the site and publishes it directly to <TechLink
            name="GitHub Pages"
          />. There are no servers to manage and no manual steps involved. The
          repository remains the single source of truth.
        </p>
      </section>

      <section
        class="animate flex flex-col gap-3"
        style="animation-delay: 420ms"
      >
        <SectionHeading numeral="V" title="Source Code" />
        <p class="text-muted-foreground">
          You can explore the full source code on <a
            href="https://github.com/BramVermeulen/bramvermeulen.github.io"
            class="link"
            target="_blank"
            rel="noopener noreferrer">GitHub</a
          >.
        </p>
      </section>
    </article>
  </main>
</Base>
